# Development only. Copy this file to .env.local, set the paths, then restart Vite.
# Point to an audited, locally extracted M2 archive root.
# Never place this directory under frontend/public or commit a populated .env.local.
M2_INTERNAL_ROOT=

# Optional when sqlite3 is not available on PATH.
M2_SQLITE_PATH=

# Données REAL :
# - non défini : backend local de démonstration http://127.0.0.1:8765
# - "static" ou "none" : exports publics sous public/data/caen-6com (déploiement Vercel)
# - URL complète : backend M4 custom
VITE_M4_API_BASE_URL=
